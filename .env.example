# ==========================================
# MEOW AI Platform — Environment Variables
# ==========================================
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to version control.

# Site URL (used for canonical URLs and Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic Claude API Key (Server-side only)
# Optional in Demo Mode: When absent, the system operates in high-fidelity deterministic simulation mode.
# When provided, activates live Anthropic Claude generation for campaign drafting and voice responses.
ANTHROPIC_API_KEY=

# Contact & Lead Notification Email (Optional)
# In demo mode, contact submissions are safely retained in the local development store.
CONTACT_NOTIFICATION_EMAIL=founder@meowai.in

# Optional transactional email provider (e.g. Resend / SendGrid)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM="MEOW AI <no-reply@meowai.in>"

# Optional Telephony Provider Credentials (Future live integration)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=

# Node Environment
NODE_ENV=development

